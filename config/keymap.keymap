#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// -------------------------------------------------------------------------
// JIS変換定義 (OSが日本語配列設定の場合の出力マッピング)
// -------------------------------------------------------------------------
#define JP_AT           LBKT             // @ (USの [ キー)
#define JP_CARET        EQUAL            // ^ (USの = キー)
#define JP_YEN          INT3             // ¥ (JISの ¥ キー)
#define JP_PIPE         LS(INT3)         // | (Shift + ¥)
#define JP_COLON        SQT              // : (USの ' キー)
#define JP_LBRACKET     RBKT             // [ (USの ] キー)
#define JP_RBRACKET     NUHS             // ] (USの \ キー / Non-US #)
#define JP_UNDERSCORE   LS(INT1)         // _ (Shift + Ro)
#define JP_BACKSLASH    INT1             // \ (Roキー)

// Shiftが必要な記号
#define JP_DQUOTE       LS(N2)           // "
#define JP_AMPERSAND    LS(N6)           // &
#define JP_QUOTE        LS(N7)           // '
#define JP_LPAREN       LS(N8)           // (
#define JP_RPAREN       LS(N9)           // )
#define JP_EQUAL        LS(MINUS)        // =
#define JP_PLUS         LS(SEMI)         // +
#define JP_ASTERISK     LS(SQT)          // *
#define JP_TILD         LS(EQUAL)        // ~
#define JP_GRAVE        LS(LBKT)         // `
#define JP_LBRACE       LS(RBKT)         // {
#define JP_RBRACE       LS(NUHS)         // }

/ {
    macros {
        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>; // キー入力間の待機時間
            tap-ms = <20>;  // キーを押している時間
            bindings
                = <&kp LS(N8)>    // 「(」を入力
                , <&kp LS(N9)>    // 「)」を入力
                , <&kp LEFT>;  // 左矢印「←」を入力してカーソルを戻す
        };

        // 単発・ホールド兼用のミドルクリックマクロ
        mclk_macro_hold: mclk_macro_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mkp MB3>
                     , <&macro_pause_for_release>
                     , <&macro_release &mkp MB3>;
        };

        // Ctrl＋ミドルクリックのホールド用マクロ
        ctrl_mclk_macro_hold: ctrl_mclk_macro_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL &mkp MB3>
                     , <&macro_pause_for_release>
                     , <&macro_release &kp LCTRL &mkp MB3>;
        };
    };

    behaviors {
        // 高速タイピング用のMod-Tap設定（Home Row Mods用）
        mt_tap: mod_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";      // ★重要：他のキーと重なってもTap（文字）を優先する
            tapping-term-ms = <200>;       // 長押しの判定時間（好みで調整）
            quick-tap-ms = <150>;          // 連続タップで文字をリピートさせる
            require-prior-idle-ms = <125>; // ★超重要：直前に別のキーを打っていたら、強制的にTapにする
            bindings = <&kp>, <&kp>;
        };
        
        // KとL専用の遅いLayer-Tap
        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; // 短く押した時は確実にキー入力を優先
            tapping-term-ms = <250>;  // ★ここを好みの長さに設定（デフォルトは200）
            quick-tap-ms = <200>;     // 連続タップ時のレイヤー暴発防止
            require-prior-idle-ms = <125>; // ★これを追加：直前に別のキー入力があれば絶対にTap(文字)にする
            bindings = <&mo>, <&kp>;  // 長押しでレイヤー(&mo)、短押しでキー(&kp)
            
            display-name = "Layer Tap Slow";
        };

        // ダブルタップ＆ホールドで連続バックスペースになるLayer-Tap
        lt_bspc: layer_tap_backspace {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>; // 通常の長押し（Hold）判定時間
            quick-tap-ms = <200>;    // ★ここがダブルタップリピートの受付時間です
            bindings = <&mo>, <&kp>; // ※もしMod-Tapとして使う場合は <&kp>, <&kp> にしてください
        };

        // ① カンマ用：ホールドでMB3、タップで通常のキー（bindingsを同一種にするためマクロでラップ）
        p_mt_mb3: p_mt_mb3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&mclk_macro_hold>, <&kp>; // 両方とも「マクロ」として扱うことでエラーを回避
        };

        // ② ドット用：ホールドでCtrl+MB3、タップで通常のキー
        p_mt_ctrl_mb3: p_mt_ctrl_mb3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&ctrl_mclk_macro_hold>, <&kp>; // 両方とも「マクロ」として扱う
        };
    };

/* トラックボールの移動をスクロールに変換する定義 */
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none      &none             &none         &none         &none       &none                                                      &none        &none  &none               &none                &none                &none
&none      &lt_slow 4 Q      &kp W         &kp E         &kp R       &kp T                                                      &kp Y        &kp U  &kp I               &kp O                &kp P                &none
&none      &mt_tap LALT A    &kp S         &kp D         &kp F       &kp G        &none                      &none              &kp H        &kp J  &lt_slow 3 K        &lt_slow 4 L         &mt_tap LALT MINUS   &none
&none      &mt_tap LSHFT Z   &kp X         &kp C         &kp V       &kp B        &kp JP_LBRACKET            &kp JP_RBRACKET    &kp N        &kp M  &p_mt_mb3 0 COMMA   &p_mt_ctrl_mb3 0 DOT &mt_tap LSHFT SLASH  &none
&none      &kp LCTRL         &kp LWIN      &kp LEFT_ALT  &lt 1 INT5  &lt 4 SPACE  &lt 3 INT4                 &lt_bspc 6 BSPC    &lt 2 RET    &none  &none               &kp JP_CARET         &lt 5 ESC            &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans     &trans               &trans            &trans              &trans                            &trans          &trans           &trans            &trans         &trans    &trans
&trans  &none      &none                &kp LC(LS(UP))    &kp PG_UP           &none                             &none           &kp LS(UP)       &kp UP            &none          &none     &trans
&trans  &kp LALT   &kp LC(LS(LEFT))     &kp LC(LS(DOWN))  &kp LC(LS(RIGHT))   &kp HOME   &trans         &none   &kp HOME        &kp LEFT         &kp DOWN          &kp RIGHT      &kp LALT  &trans
&trans  &kp LSHFT  &kp LA(PG_UP)        &kp PG_DN         &kp LA(PG_DN)       &kp END    &kp LG(LS(C))  &none   &kp END         &kp LS(LEFT)     &kp LS(DOWN)      &kp LS(RIGHT)  &kp LSHFT &trans
&trans  &kp LCTRL  &kp LWIN             &kp LALT          &trans              &trans     &trans         &trans  &kp LA(ENTER)   &trans           &trans            &trans         &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans       &trans      &trans           &trans        &trans                          &trans        &trans           &trans            &trans         &trans       &trans
&trans  &kp N1       &kp N2      &kp N3           &kp N4        &kp N5                          &none         &kp LS(UP)       &kp UP            &none          &none        &trans
&trans  &kp N6       &kp N7      &kp N8           &kp N9        &kp N0   &trans         &trans  &kp HOME      &kp LEFT         &kp DOWN          &kp RIGHT      &kp LALT     &trans
&trans  &kp LS(SEMI) &kp MINUS   &kp LS(JP_COLON) &kp FSLH      &kp DOT  &kp LS(MINUS)  &trans  &kp END       &kp LS(LEFT)     &kp LS(DOWN)      &kp LS(RIGHT)  &kp LSHFT    &trans
&trans  &kp LCTRL    &kp LWIN    &kp LALT         &macro_parens &kp F10  &kp F2         &trans  &kp LA(ENTER) &trans           &trans            &trans         &trans       &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans        &trans        &trans        &trans          &trans                                                     &trans        &trans       &trans           &trans            &trans         &trans
&trans  &kp LS(N7)    &kp LS(N2)    &kp JP_YEN    &none           &kp LS(SEMI)                                               &kp JP_YEN    &kp LS(0x87) &kp LS(N8)       &kp LS(N9)        &kp LS(N5)     &trans
&trans  &kp JP_AT     &kp SEMI      &kp LS(N4)    &kp JP_LBRACKET &kp JP_RBRACKET  &trans               &trans               &kp LS(N3)    &mkp LCLK    &kp LS(JP_COLON) &mkp RCLK         &kp LS(MINUS)  &trans
&trans  &kp LSHFT     &none         &kp JP_COLON  &none           &kp LS(N1)       &kp LS(JP_LBRACKET)  &kp LS(JP_RBRACKET)  &kp LS(N6)    &kp MINUS    &kp LS(COMMA)    &kp LS(DOT)       &kp LS(FSLH)   &trans
&trans  &kp LCTRL     &kp LWIN      &kp LALT      &trans          &trans           &trans               &trans               &kp LC(ENTER) &trans       &trans           &kp LS(JP_CARET)  &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans     &trans         &trans         &trans         &trans                             &trans        &trans     &trans      &trans       &trans      &trans
&trans  &none      &kp TAB        &kp LC(UP)     &kp LG(UP)     &none                              &trans        &trans     &trans      &trans       &trans      &trans
&trans  &kp LALT   &kp LC(LEFT)   &kp LC(DOWN)   &kp LC(RIGHT)  &none    &trans         &trans     &kp LC(C)     &mkp LCLK  &mkp RCLK   &mkp RCLK    &kp LALT    &trans
&trans  &kp LSHFT  &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &none    &kp LG(LC(T))  &kp LG(V)  &kp LC(V)     &kp LC(Z)  &kp LC(Y)   &none        &kp LSHFT   &trans
&trans  &kp LCTRL  &kp LWIN       &kp LALT       &trans         &trans   &trans         &kp DEL    &kp LS(ENTER) &trans     &trans      &kp LC(X)    &trans      &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans          &trans        &trans        &trans          &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LCTRL       &kp LWIN      &kp LALT      &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans     &trans    &trans       &trans    &trans                                  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp F1     &kp F2    &kp F3       &kp F4    &kp F5                                  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp F6     &kp F7    &kp F8       &kp F9    &kp F10  &trans     &trans      &trans  &trans  &trans  &trans  &trans  &kp LALT  &trans
&trans  &kp F11    &kp F12   &trans       &trans    &trans   &trans     &trans      &trans  &trans  &trans  &trans  &trans  &kp LSHFT &trans
&trans  &kp LCTRL  &kp LWIN  &kp LALT     &kp TAB   &kp RET  &kp BSPC   &trans      &trans  &trans  &trans  &trans  &trans  &trans    &trans
            >;
        };
    };
};

&pointing_listener {
    status = "okay";
    device = <&pointing_device>; // ★これが不足していたためエラーになっていました！
    input-processors = <&zip_scroll_scaler 1 1>;
    layers = <3>; // レイヤー3が押されている間スクロールにする設定
};
